{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "蛋蛋便签",
  "version": "0.1.3",
  "identifier": "com.desktop.notewidget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "蛋蛋便签",
        "label": "main",
        "width": 420,
        "height": 620,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:notebook.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
